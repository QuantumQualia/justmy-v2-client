# =============================================================================
# JustMy web app (Next.js) — copy to `.env` (or `.env.local`) and fill in.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time:
# change them in Vercel, then redeploy.
# =============================================================================

# -----------------------------------------------------------------------------
# URLs (`lib/config.ts`, `lib/hosts.ts`)
# -----------------------------------------------------------------------------
# Public origin of this web app (myCARD share links, canonical URLs, JSON-LD).
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Site origin for metadata + embed snippets (defaults to https://justmy.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# NestJS API origin used from the browser.
NEXT_PUBLIC_API_URL=http://localhost:3000
# Server-only API origin (BFF routes, SSR). Falls back to NEXT_PUBLIC_API_URL.
# API_URL=http://localhost:3000

# Comma-separated hostnames (no protocol) that serve the NewsSTAND zip router.
# Default when unset: news.justmy.com
# NEXT_PUBLIC_NEWS_HOSTS=news.justmy.com

# -----------------------------------------------------------------------------
# Sign in (`lib/auth/oauth-providers.ts`)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_APPLE_CLIENT_ID=com.example.justmy.web
# Defaults to the current page origin.
# NEXT_PUBLIC_APPLE_REDIRECT_URI=http://localhost:3001

# -----------------------------------------------------------------------------
# AskSKY
# -----------------------------------------------------------------------------
# Text SKY number shown on the AskSKY card + launcher (`asksky-text-line.tsx`).
# Hidden when unset. Must match the Twilio number the API webhook listens on.
# NEXT_PUBLIC_SKY_SMS_NUMBER=55752
# Keyword prefilled in the sms: link (default SKY).
# NEXT_PUBLIC_SKY_SMS_KEYWORD=SKY

# Cache-busting `?v=` for the embed script snippets (e.g. a git SHA).
# NEXT_PUBLIC_ASKSKY_EMBED_SCRIPT_VERSION=2
# NEXT_PUBLIC_MYFORM_EMBED_SCRIPT_VERSION=1

# -----------------------------------------------------------------------------
# NewsSTAND home (`components/news/home/links.ts`)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_NEWSSTAND_COMMUNITY_VIDEO_URL=
# NEXT_PUBLIC_NEWSSTAND_COMMUNITY_POSTER_URL=
# Fallback social account when a market has none.
# NEXT_PUBLIC_NEWSSTAND_FALLBACK_SOCIAL_PLATFORM=instagram
# NEXT_PUBLIC_NEWSSTAND_FALLBACK_SOCIAL_HANDLE=justmy
# NEXT_PUBLIC_NEWSSTAND_FALLBACK_SOCIAL_URL=https://www.instagram.com/justmy

# -----------------------------------------------------------------------------
# Server-only integrations
# -----------------------------------------------------------------------------
# Unsplash image search (`lib/unsplash-server.ts`). Either name works.
# UNSPLASH_ACCESS_KEY=
# UNSPLASH_CLIENT_ID=

# On-demand ISR (`app/api/revalidate/route.ts`).
# REVALIDATE_SECRET=
# ENABLE_MANUAL_REVALIDATE_ENDPOINT=false
